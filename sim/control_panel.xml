<mujoco model="daikin_control_panel">
  <default>
    <!-- 当たり判定の組み分け:
         ロボット(contype=1, conaffinity=1)とは当たる。パネル本体どうし、本体とボタン、ボタンどうしは当たらない。
         パネル本体 contype=2、ボタン contype=4、どちらも conaffinity=1。
         ※トップレベルの <default> に直接書くと、include したときにロボット側の geom にも効くので、クラスに書く -->
    <default class="panel_static">
      <geom contype="2" conaffinity="1"/>
    </default>
    <!-- ボタンのばね: 1mm 押し切るのに約1.5N(1500 N/m)。solreflimit で押し込みの上限(1mm)を硬く止める -->
    <!-- 四角いボタン(四隅用、25 x 15mm) -->
    <default class="btn_rect">
      <geom type="box" size="0.0125 0.002 0.0075" rgba="0.92 0.93 0.95 1" mass="0.005" contype="4" conaffinity="1"/>
      <joint type="slide" axis="0 1 0" limited="true" range="0 0.001" stiffness="1500" damping="1.5" solreflimit="0.004 1"/>
    </default>
    <!-- 円形ボタン(中央のメニュー/確定用。半径は各ボタンで指定) -->
    <default class="btn_round">
      <geom type="cylinder" size="0.010 0.002" quat="0.7071 0.7071 0 0" rgba="0.88 0.90 0.93 1" mass="0.005" contype="4" conaffinity="1"/>
      <joint type="slide" axis="0 1 0" limited="true" range="0 0.001" stiffness="1500" damping="1.5" solreflimit="0.004 1"/>
    </default>
    <!-- 小型ボタン（中央十字の上下左右用） -->
    <default class="btn_small">
      <geom type="box" size="0.006 0.002 0.004" rgba="0.90 0.92 0.94 1" mass="0.003" contype="4" conaffinity="1"/>
      <joint type="slide" axis="0 1 0" limited="true" range="0 0.001" stiffness="1500" damping="1.5" solreflimit="0.004 1"/>
    </default>
  </default>

  <worldbody>
    <!-- 寸法は 12cm_x_12cm.html の設計図(左上が原点、右に X、下に Y、mm)による。
         パネル座標: 中心が原点、x = (X - 60)/1000、z = (60 - Y)/1000、正面が -y、押し込みが +y -->
    <!-- 動的配置用の親ボディ(位置と向きは env_builder.py の button_pos / panel_rpy_deg で決める) -->
    <body name="control_panel_root" pos="0 0 0">
      <!-- 1. パネル本体外枠(120 x 18 x 120mm、厚みは実測)。正面を y=-0.010 にそろえ、裏面は y=+0.008 -->
      <geom name="panel_board" class="panel_static" type="box" size="0.06 0.009 0.06" pos="0 -0.001 0" rgba="0.96 0.96 0.96 1"/>

      <!-- 2. 液晶ディスプレイ(枠: X 25〜95、Y 10〜60、70 x 50mm。表示部: 66 x 46mm) -->
      <geom name="lcd_bezel" class="panel_static" type="box" size="0.035 0.001 0.025" pos="0.0000 -0.011 0.0250" rgba="0.70 0.72 0.72 1"/>
      <geom name="lcd_screen" class="panel_static" type="box" size="0.033 0.001 0.023" pos="0.0000 -0.0115 0.0250" rgba="0.72 0.80 0.72 1"/>

      <!-- 3. 中央の円形操作ユニット(中心 60, 90、半径 25mm) -->
      <geom name="center_dial_base" class="panel_static" type="cylinder" size="0.025 0.001" pos="0.0000 -0.011 -0.0300" quat="0.7071 0.7071 0 0" rgba="0.86 0.88 0.90 1"/>

      <!-- 4. 電源LED(設計図にないので、運転/停止ボタンの右に仮置き) -->
      <geom name="power_led" class="panel_static" type="cylinder" size="0.002 0.001" pos="0.0550 -0.011 -0.0175" quat="0.7071 0.7071 0 0" rgba="0.0 0.9 0.2 1"/>

      <!-- ==================== 中央の円形ユニット ====================
           四隅と同じ理由で、ボタンの正面は台座の面から押し込める量(1mm)だけ出す -->
      <!-- [中心] メニュー / 確定(半径 5mm)(設計図の中心 60, 90) -->
      <body name="btn_menu" pos="0.0000 -0.011 -0.0300">
        <joint name="joint_menu" class="btn_round"/>
        <geom name="geom_menu" class="btn_round" size="0.005 0.002"/>
        <site name="site_menu" pos="0 -0.002 0" size="0.004 0.001" type="cylinder" quat="0.7071 0.7071 0 0"/>
      </body>
      <!-- [上] 温度 ▲(設計図にないので、円の中心から 15mm に仮置き)(設計図の中心 60, 75) -->
      <body name="btn_temp_up" pos="0.0000 -0.011 -0.0150">
        <joint name="joint_temp_up" class="btn_small"/>
        <geom name="geom_temp_up" class="btn_small"/>
        <site name="site_temp_up" pos="0 -0.002 0" size="0.005 0.001 0.003" type="box"/>
      </body>
      <!-- [下] 温度 ▼(同上)(設計図の中心 60, 105) -->
      <body name="btn_temp_down" pos="0.0000 -0.011 -0.0450">
        <joint name="joint_temp_down" class="btn_small"/>
        <geom name="geom_temp_down" class="btn_small"/>
        <site name="site_temp_down" pos="0 -0.002 0" size="0.005 0.001 0.003" type="box"/>
      </body>
      <!-- [左] ◀(同上)(設計図の中心 45, 90) -->
      <body name="btn_left" pos="-0.0150 -0.011 -0.0300">
        <joint name="joint_left" class="btn_small"/>
        <geom name="geom_left" class="btn_small" size="0.004 0.002 0.005"/>
        <site name="site_left" pos="0 -0.002 0" size="0.003 0.001 0.004" type="box"/>
      </body>
      <!-- [右] ▶(同上)(設計図の中心 75, 90) -->
      <body name="btn_right" pos="0.0150 -0.011 -0.0300">
        <joint name="joint_right" class="btn_small"/>
        <geom name="geom_right" class="btn_small" size="0.004 0.002 0.005"/>
        <site name="site_right" pos="0 -0.002 0" size="0.003 0.001 0.004" type="box"/>
      </body>

      <!-- ==================== 四隅のボタン(25 x 15mm) ====================
           実物は出っ張りのない押し込み式。ただしシミュでは、ボタンの後ろもパネル本体の箱で埋まっているので、
           面と同じ高さにすると押し込めない(本体に当たって止まる)。そこで押し込める量(1mm)だけ前に出し、
           押し切るとパネル面とそろうようにしてある -->
      <!-- [左上] 運転切換(X 10〜35、Y 70〜85)(設計図の中心 22.5, 77.5) -->
      <body name="btn_mode" pos="-0.0375 -0.009 -0.0175">
        <joint name="joint_mode" class="btn_rect"/>
        <geom name="geom_mode" class="btn_rect"/>
        <site name="site_mode" pos="0 -0.002 0" size="0.011 0.001 0.006" type="box"/>
      </body>
      <!-- [右上] 運転/停止(X 85〜110、Y 70〜85)(設計図の中心 97.5, 77.5) -->
      <body name="btn_power" pos="0.0375 -0.009 -0.0175">
        <joint name="joint_power" class="btn_rect"/>
        <geom name="geom_power" class="btn_rect" rgba="0.95 0.95 0.98 1"/>
        <site name="site_power" pos="0 -0.002 0" size="0.011 0.001 0.006" type="box"/>
      </body>
      <!-- [左下] 風量/風向(X 10〜35、Y 95〜110)(設計図の中心 22.5, 102.5) -->
      <body name="btn_fan" pos="-0.0375 -0.009 -0.0425">
        <joint name="joint_fan" class="btn_rect"/>
        <geom name="geom_fan" class="btn_rect"/>
        <site name="site_fan" pos="0 -0.002 0" size="0.011 0.001 0.006" type="box"/>
      </body>
      <!-- [右下] キャンセル(X 85〜110、Y 95〜110)(設計図の中心 97.5, 102.5) -->
      <body name="btn_cancel" pos="0.0375 -0.009 -0.0425">
        <joint name="joint_cancel" class="btn_rect"/>
        <geom name="geom_cancel" class="btn_rect"/>
        <site name="site_cancel" pos="0 -0.002 0" size="0.011 0.001 0.006" type="box"/>
      </body>
    </body>
  </worldbody>

  <sensor>
    <touch name="sensor_power" site="site_power"/>
    <touch name="sensor_mode" site="site_mode"/>
    <touch name="sensor_menu" site="site_menu"/>
    <touch name="sensor_temp_up" site="site_temp_up"/>
    <touch name="sensor_temp_down" site="site_temp_down"/>
    <touch name="sensor_left" site="site_left"/>
    <touch name="sensor_right" site="site_right"/>
    <touch name="sensor_fan" site="site_fan"/>
    <touch name="sensor_cancel" site="site_cancel"/>
  </sensor>
</mujoco>